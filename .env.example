# ─────────────────────────────────────────────────────────────
# OpsPilot AI — configuration. Copy to `.env` and adjust.
# Every variable the server reads is listed here.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public URL of the web app (used in invitation / reset links).
APP_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS, CSRF origin checks and Socket.IO.
CLIENT_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (for correct client IPs / rate limits).
TRUST_PROXY=0

# ── Data stores ──────────────────────────────────────────────
# MongoDB Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/opspilot?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/opspilot
# Keep true for MongoDB / Atlas. Only set false for MongoDB-compatible servers without TTL indexes (FerretDB).
MONGO_TTL_INDEXES=true
REDIS_URL=redis://127.0.0.1:6379

# ── Authentication ───────────────────────────────────────────
# REQUIRED. At least 32 random characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Defaults to true in production. Must be true when COOKIE_SAMESITE=none.
# COOKIE_SECURE=true
# lax (same-site deployments) | strict | none (API and web on different sites; requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com
BCRYPT_ROUNDS=12

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_15MIN=30
API_RATE_LIMIT_PER_MINUTE=600
AI_RATE_LIMIT_PER_MINUTE=10

# ── AI triage ────────────────────────────────────────────────
# mock      → built-in keyword heuristic. NOT an AI model; every result is labeled as a mock.
# anthropic → Anthropic Messages API        (needs AI_API_KEY)
# openai    → OpenAI or any OpenAI-compatible API (needs AI_API_KEY, optional AI_BASE_URL)
AI_PROVIDER=mock
# Secret. Server-side only — never exposed to the browser.
AI_API_KEY=
# Defaults: anthropic → claude-sonnet-5-5, openai → gpt-4o-mini
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# ── SLA automation ───────────────────────────────────────────
# 1 = real time. Set to 60 for development: one SLA "minute" lasts one real second
# (a 15-minute response target becomes 15 seconds). NEVER use in production.
SLA_TIME_SCALE=1
SLA_SCAN_INTERVAL_SECONDS=30
SLA_JOBS_ENABLED=true

# ── Attachments ──────────────────────────────────────────────
# local → files on disk (default; no cloud needed)   s3 → any S3-compatible store
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=us-east-1
# For MinIO / R2 / etc.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Email ────────────────────────────────────────────────────
# Without SMTP_URL, emails are NOT delivered: the link is written to the server log (and, outside production,
# returned to admins when they invite someone). Example: smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=OpsPilot AI <no-reply@opspilot.local>

# ── Client (read by Vite at build/dev time; never put secrets here) ──
VITE_API_PROXY_TARGET=http://localhost:4000
